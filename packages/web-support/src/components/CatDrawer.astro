---
import SideTree from './SideTree.astro'
import { getContent } from '../lib/content'
import { getDict, LOCALE_LABELS } from '../lib/i18n'
import { REGION, localePath } from '../lib/site'

interface Props {
  /** 当前页面站内路径，语言切换跳同一页的其它语言版本(窄屏下顶栏的地区 / 语言菜单是隐藏的) */
  pagePath: string
  currentSlug?: string
}
const { pagePath, currentSlug } = Astro.props
const locale = Astro.locals.locale
const d = getDict(locale)
const { nav } = getContent(locale)
---

<div class="lb-cat-drawer" id="lb-cat-drawer" hidden aria-hidden="true">
  <div class="lb-cat-drawer__backdrop" data-lb-cat-drawer-close></div>
  <div class="lb-cat-drawer__panel" role="dialog" aria-modal="true" aria-label={d.helpCenter}>
    <div class="lb-cat-drawer__header">
      <span class="lb-cat-drawer__title">{d.helpCenter}</span>
      <button type="button" class="lb-cat-drawer__close" data-lb-cat-drawer-close aria-label={d.close}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg>
      </button>
    </div>
    <nav class="side-tree" aria-label={d.categories}>
      <SideTree nav={nav} currentSlug={currentSlug} />
    </nav>
    <div class="lb-cat-drawer__langs" aria-label={d.language} data-lb-locale-links>
      {REGION.locales.map((l) => (
        <a href={localePath(l, pagePath)} hreflang={l} lang={l} class:list={['lb-cat-drawer__lang', { 'is-active': l === locale }]} aria-current={l === locale ? 'true' : undefined}>{LOCALE_LABELS[l]}</a>
      ))}
    </div>
  </div>
</div>

<script>
  import '../scripts/drawer.ts'
</script>
<script>
  import '../scripts/side-tree.ts'
</script>

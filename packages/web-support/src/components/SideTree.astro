---
import CatIcon from './CatIcon.astro'
import type { NavCategory } from '../lib/nav-core'
import { localePath } from '../lib/site'

interface Props {
  nav: NavCategory[]
  /** 当前文章 slug(文章页);其余页面不传，树全部折叠 */
  currentSlug?: string
}

const { nav, currentSlug } = Astro.props
const locale = Astro.locals.locale
const CHEVRON_SVG = `<svg class="side-tree__chevron" viewBox="0 0 12 12" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" d="M3 4.5l2.6 2.6c.2.2.5.2.7 0L9 4.5"></path></svg>`
---

{nav.map((cat) => {
  const openSecs = new Set(cat.sections.filter((s) => s.articles.some((a) => a.slug === currentSlug)).map((s) => s.slug))
  const catIsOpen = openSecs.size > 0
  return (
    <div class:list={['side-tree__cat', catIsOpen && 'is-open']}>
      <button type="button" class="side-tree__cat-head" aria-expanded={catIsOpen ? 'true' : 'false'}>
        <span class="side-tree__cat-icon" aria-hidden="true"><CatIcon slug={cat.slug} icon={cat.icon} /></span>
        <span class="side-tree__cat-label">{cat.title}</span>
        <Fragment set:html={CHEVRON_SVG} />
      </button>
      <div class="side-tree__cat-body">
        {cat.sections.map((sec) => {
          const secIsOpen = openSecs.has(sec.slug)
          return (
            <div class:list={['side-tree__sec', secIsOpen && 'is-open']}>
              <button type="button" class="side-tree__sec-head" aria-expanded={secIsOpen ? 'true' : 'false'}>
                <span>{sec.title}</span>
                <Fragment set:html={CHEVRON_SVG} />
              </button>
              <div class="side-tree__sec-body">
                {sec.articles.map((a) => {
                  const isCurrent = a.slug === currentSlug
                  return (
                    <a href={localePath(locale, a.path)} data-slug={a.slug} class:list={['side-tree__item', isCurrent && 'is-current']} aria-current={isCurrent ? 'page' : undefined}>
                      {a.title}
                    </a>
                  )
                })}
              </div>
            </div>
          )
        })}
      </div>
    </div>
  )
})}

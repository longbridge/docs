---
// SearchModal.astro — Zendesk-style search modal backed by Pagefind (Task 6)
// HTML mirroring header.hbs:151-163; JS in search.ts
import { getDict } from '../lib/i18n'

const d = getDict(Astro.locals.locale)
---

<div id="lb-search-modal" class="lb-search-modal" hidden aria-hidden="true">
  <div class="lb-search-modal__backdrop" data-close></div>
  <div class="lb-search-modal__panel" role="dialog" aria-modal="true" aria-label={d.search}>
    <div class="lb-search-modal__head">
      <svg class="lb-search-modal__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input
        type="search"
        id="lb-search-input"
        class="lb-search-modal__input"
        placeholder={d.searchPlaceholder}
        autocomplete="off"
        spellcheck="false"
        aria-label={d.search}
      />
      <button type="button" class="lb-search-modal__close" data-close aria-label={d.close}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 4L4 20M4 4L20 20"/>
        </svg>
      </button>
    </div>
    <div class="lb-search-modal__body" id="lb-search-results">
      <div class="lb-search-modal__hint">{d.searchHint}</div>
    </div>
  </div>
</div>

<script>
  import '../scripts/search.ts'
</script>

---
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/header.css'
import '../styles/footer.css'
import '../styles/side-tree.css'
import '../styles/search.css'
import '../styles/whale.css'
import Header from '../components/Header.astro'
import AppNavbar from '../components/AppNavbar.astro'
import Footer from '../components/Footer.astro'
import CatDrawer from '../components/CatDrawer.astro'
import SearchModal from '../components/SearchModal.astro'
import themeMode from '../scripts/theme-mode.js?raw'
import { SITE_ORIGIN, OG_IMAGE } from '../lib/seo'

interface Props {
  title: string
  description?: string
  isHome?: boolean
  hideFooter?: boolean
}

const { title, description, isHome = false, hideFooter = false } = Astro.props

// hero 背景图的 CDN 变体(阿里云 OSS 处理参数)。⚠️ 必须与 home.css 中的 URL 逐字一致,
// 否则 preload 不命中,浏览器会把同一张图下载两次。改一处务必同步另一处。
const HERO_BG = 'https://assets.lbkrs.com/uploads/962fe7f1-bbf1-462c-80b8-35f72d462e18/hero-bg3.png'
const HERO_IMG_MOBILE = `${HERO_BG}?x-oss-process=image/resize,w_1000/format,webp`
const HERO_IMG_DESKTOP = `${HERO_BG}?x-oss-process=image/resize,w_1200/format,webp`
const HERO_IMG_DESKTOP_2X = `${HERO_BG}?x-oss-process=image/resize,w_1600/format,webp`
const pageTitle = isHome ? 'Longbridge Help Center' : `${title} – Longbridge Help Center`

// SEO / 社交分享 unfurl(Slack / Facebook / Twitter)。SITE_ORIGIN / OG_IMAGE 单一来源见 lib/seo。
// canonical 指向生产域,staging(xyz)也归一到它做 SEO 去重;og:image 须绝对且公网可访问(Slackbot 无登录态)。
const pageUrl = SITE_ORIGIN + Astro.url.pathname
const shareDesc = description ?? "Got a question? From account setup to placing a trade, we've got you covered."
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- 图片 CDN 预连接:首页 hero/sun 与全站 logo 同域,提前完成 DNS+TLS(Lighthouse 实测省 ~300ms)。
         不加 crossorigin —— 背景图是非 CORS 请求,加了反而会另开一条连接。 -->
    <link rel="preconnect" href="https://assets.lbkrs.com" />
    <!-- hero 背景图是 CSS background,要等 CSS 解析完才被发现,起步晚且正是 LCP 元素。
         按断点各预载一档抢跑;仅首页,其他页不浪费。 -->
    {isHome && <link rel="preload" as="image" media="(max-width: 900px)" href={HERO_IMG_MOBILE} />}
    {isHome && <link rel="preload" as="image" media="(min-width: 901px) and (max-resolution: 1.99dppx)" href={HERO_IMG_DESKTOP} />}
    {isHome && <link rel="preload" as="image" media="(min-width: 901px) and (min-resolution: 2dppx)" href={HERO_IMG_DESKTOP_2X} />}
    <link rel="icon" href="https://assets.wbrks.com/assets/logo/logo1.png" type="image/png" />
    <title>{pageTitle}</title>
    <meta name="description" content={shareDesc} />
    <link rel="canonical" href={pageUrl} />
    <!-- Open Graph（Slack / Facebook 等 unfurl 读这套显示标题/简介/图）-->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Longbridge Help Center" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={shareDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={OG_IMAGE} />
    <!-- Twitter card（summary_large_image = 1200×630 整卡大图）-->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={shareDesc} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <!-- Anti-FOUC: theme applied before first paint(内含 UA lbcommitid → html.is-whale-app) -->
    <script is:inline set:html={themeMode} />
    <!-- 沉浸式(原生 lbFitsStatusBar=2:状态栏透明不占位)给 html 打标,供 whale.css 兜底 Android 状态栏高度;首屏前执行避免跳变 -->
    <script is:inline>
      ;(function () {
        if (/[?&]lbFitsStatusBar=2(?![0-9])/.test(location.search)) {
          document.documentElement.classList.add('is-immersive-sb')
        }
      })()
    </script>
    <!-- App WebView 内禁用双指/双击缩放(对齐 Zendesk document_head.hbs:2) -->
    <script is:inline>
      ;(function () {
        var ua = navigator.userAgent || ''
        if (!/longbridge|whale|_dsbridge/i.test(ua)) return
        var m = document.querySelector('meta[name="viewport"]')
        if (!m) return
        var c = m.getAttribute('content') || ''
        if (c.indexOf('user-scalable') > -1) return
        m.setAttribute('content', c + ', user-scalable=no, maximum-scale=1.0, minimum-scale=1.0')
      })()
    </script>
    {
      import.meta.env.DEV && (
        <script is:inline>
          /* 仅 dev：?lb-whale=1 在普通浏览器 / 模拟器 Safari 里模拟 App 环境；?lb-debug=1 屏幕上打印顶部间距读数 */
          ;(function () {
            var q = location.search
            if (/[?&]lb-whale=1/.test(q)) document.documentElement.classList.add('is-whale-app')
            if (!/[?&]lb-debug=1/.test(q)) return
            addEventListener('load', function () {
              var cs = function (el, p) { return el ? getComputedStyle(el).getPropertyValue(p) : 'n/a' }
              var top = function (el) { return el ? Math.round(el.getBoundingClientRect().top) : 'n/a' }
              var probe = document.createElement('div')
              probe.style.cssText = 'position:fixed;padding-top:env(safe-area-inset-top,0px);visibility:hidden'
              document.body.appendChild(probe)
              var html = document.documentElement
              var rows = [
                ['ua', navigator.userAgent.slice(-60)],
                ['html.class', html.className],
                ['env(safe-top)', cs(probe, 'padding-top')],
                ['--lb-safe-top', cs(html, '--lb-safe-top')],
                ['viewport', innerWidth + 'x' + innerHeight + ' scale ' + (visualViewport ? visualViewport.scale : '?')],
                ['navbar bottom', document.querySelector('.lb-app-navbar') ? Math.round(document.querySelector('.lb-app-navbar').getBoundingClientRect().bottom) : 'n/a'],
                ['outer main pt', cs(document.querySelector('body > main#main-content'), 'padding-top')],
                ['hero pt', cs(document.querySelector('.hero'), 'padding-top')],
                ['hero top', top(document.querySelector('.hero'))],
                ['hero__inner pt', cs(document.querySelector('.hero__inner'), 'padding-top')],
                ['hero__inner top', top(document.querySelector('.hero__inner'))],
                ['hero-title mt', cs(document.querySelector('.hero-title'), 'margin-top')],
                ['hero-title top', top(document.querySelector('.hero-title'))],
                ['h1 top', top(document.querySelector('.article-title'))],
              ]
              var box = document.createElement('pre')
              box.style.cssText = 'position:fixed;left:0;right:0;bottom:0;z-index:99999;margin:0;padding:8px;background:rgba(0,0,0,.85);color:#0f0;font:11px/1.4 monospace;white-space:pre-wrap'
              box.textContent = rows.map(function (r) { return r[0] + ': ' + r[1] }).join('\n')
              document.body.appendChild(box)
            })
          })()
        </script>
      )
    }
  </head>
  <body class={isHome ? 'lb-has-hero' : undefined}>
    <a class="skip-navigation" href="#main-content">Skip to main content</a>
    <AppNavbar />
    <Header />
    <CatDrawer />
    <SearchModal />
    <main id="main-content">
      <slot />
    </main>
    {!hideFooter && <Footer isHome={isHome} />}
  </body>
</html>

---

interface Props {
  isHome?: boolean
}
const { isHome = false } = Astro.props

const FOOTER_LINKS = [
  { label: 'BrokerCheck', href: 'https://brokercheck.finra.org/' },
  { label: 'Form CRS', href: 'https://assets.lbkrs.com/uploads/51d37842-0dc1-42f0-bf24-fe36c7da20e3/LBS-Form-CRS-final-.pdf' },
  { label: 'Fees & Charges', href: 'https://assets.lbkrs.com/uploads/bc116567-a61a-4a3a-972d-e540b8eba635/Fee-Schedule.pdf' },
  { label: 'Business Continuity Plan', href: 'https://assets.lbkrs.com/uploads/dd20724a-f3d6-4ca5-a94c-61ff1ab9d691/BCP-Disclosure-final-.pdf' },
]
---

<footer class:list={["lb-footer", { "lb-footer--home": isHome }]}>
  <div class="lb-footer__main">
    <div class="lb-footer__brand">
      <p class="lb-footer__tagline">Explore. Inspire. Trade.</p>
      <p class="lb-footer__meta">
        Member FINRA / <a href="https://www.sipc.org/" target="_blank" rel="noopener noreferrer">SIPC</a> · © 2026 Long Bridge Securities LLC.
      </p>
      <div class="lb-footer__links-clip">
        <ul class="lb-footer__links">
          {FOOTER_LINKS.map((l) => (
            <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <a
      href="https://assets.lbkrs.com/uploads/a105e31a-1337-4b33-926a-01f5ea21e412/Disclosure-Library.pdf"
      class="lb-footer__logo-link"
      aria-label="Longbridge Disclosures"
      target="_blank"
      rel="noopener noreferrer"
    >
      <!-- footer 专用 "Disclosures" logo(与 header 不同):浅色主题深墨,深色主题浅墨 -->
      <img
        src="https://assets.lbkrs.com/uploads/05c08735-c894-4890-9a92-9b39baba23d1/footer-logo-light.png"
        alt="Longbridge"
        class="lb-footer__logo lb-footer__logo--light"
        width="474"
        height="66"
        loading="lazy"
        decoding="async"
      />
      <img
        src="https://assets.lbkrs.com/uploads/ca214fbc-ab34-4578-9ae6-40129402b9f8/footer-logo-dark.png"
        alt="Longbridge"
        class="lb-footer__logo lb-footer__logo--dark"
        width="474"
        height="66"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>

  <div class="lb-footer__divider" role="presentation"></div>

  <p class="lb-footer__disclaimer">
    This communication is for informational purposes only and is not investment advice, a recommendation, or an offer or solicitation to buy or sell any security or crypto asset. Investing involves risk, including possible loss of principal. AI-generated content may be incomplete or inaccurate and should not be relied upon as the sole basis for any investment decision. Cryptocurrency is not protected by SIPC. Promotional offers are subject to eligibility requirements, deposit requirements, limitations, and terms and conditions.
  </p>
  <p class="lb-footer__disclaimer lb-footer__disclaimer--affiliate">
    Longbridge AI Technologies LLC is an affiliated technology company of Long Bridge Securities LLC and provides software, platform, and technology services that support the Longbridge investing experience. It is not a broker-dealer and does not provide securities brokerage services.
  </p>
</footer>

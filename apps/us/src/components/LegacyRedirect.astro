---
// 旧三段式文章地址的跳转页,映射见 src/data/legacy-article-paths.ts。
// 不用 Astro 自带 redirects:它只生成 meta refresh,会丢掉 ?query 和 #hash,而 App 靠
// lbFitsStatusBar=2 这类参数控制导航栏顶距。这里先用 JS 带着 query/hash 跳,JS 不可用时退回 meta refresh。
import { SITE_ORIGIN } from '../lib/seo'

interface Props {
  to: string // 含 base 的新地址,如 /us/en/support/articles/123
}

const { to } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline define:vars={{ to }}>
      location.replace(to + location.search + location.hash)
    </script>
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={SITE_ORIGIN + to} />
    <title>Redirecting…</title>
  </head>
  <body>
    <a href={to}>This article has moved. Continue →</a>
  </body>
</html>

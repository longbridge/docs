{
  "name": "@lb-docs/web-sg",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir support/pagefind && bun run ../../packages/web-support/scripts/normalize-pagefind.ts",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "bun run ../../packages/web-support/scripts/fetch-support.ts --region sg"
  },
  "dependencies": {
    "@lb-docs/web-support": "workspace:*",
    "astro": "^7.2.0",
    "pagefind": "^1.0.0"
  }
}
